# Supabase configuration — get these from your Supabase project dashboard
# Leave empty to use local IndexedDB storage (no auth needed)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo AI key — built-in key so visitors can try AI parsing without their own key
# Set in Vercel env vars (never commit the actual key). Provider: anthropic | openai | gemini
VITE_DEMO_AI_PROVIDER=
VITE_DEMO_AI_KEY=
